# ==========================================
# PRODUCTION ENVIRONMENT VARIABLES EXAMPLE
# ==========================================

# 1. Server Config
NODE_ENV=production
PORT=8080

# 2. Supabase Keys (From Supabase Dashboard -> Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-never-expose-to-frontend
SUPABASE_JWT_SECRET=your-jwt-secret-from-supabase

# 3. Redis (Required for BullMQ async processing)
REDIS_URL=rediss://default:YOUR_PASSWORD@your-endpoint.upstash.io:6379

# 4. Security
# Random secure string for internal cron jobs/webhooks to authenticate
INTERNAL_API_KEY=your-random-secure-string

# 5. Observability
# Sentry DSN for backend error tracking
SENTRY_DSN=
