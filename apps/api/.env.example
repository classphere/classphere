# ==========================================
# BACKEND API ENVIRONMENT VARIABLES EXAMPLE
# ==========================================

# 1. Server Config
NODE_ENV=production
PORT=3001
APP_URL=http://localhost:3000
APP_BASE_DOMAIN=classphere.com
ALLOWED_WEB_ORIGINS=
START_WORKERS=false # true on standalone worker dyno/container

# 2. Supabase Keys
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-never-expose-to-frontend
SUPABASE_JWT_SECRET=your-jwt-secret-from-supabase

# 3. Redis (Required for BullMQ async processing)
REDIS_URL=rediss://default:YOUR_PASSWORD@your-endpoint.upstash.io:6379

# 4. Security
INTERNAL_API_KEY=328139b0b82dba4e78267695a05377771dffe3bb11bd2d410a750bc5c922544e
SESSION_BINDING_SECRET=2835b81c817300c01e69e0fad9fb8e9d5d6f3341d12228afb2f19a9cba7f37b6

# 5. Datalab Marker (webhook-first PDF extraction)
DATALAB_API_KEY=your-datalab-api-key
# Public callback prefix; worker appends /:jobId per extraction.
DATALAB_WEBHOOK_BASE_URL=https://api.classphere.com/api/v1/webhooks/datalab/marker
# Configure this exact same secret in Datalab Settings -> Webhooks.
DATALAB_WEBHOOK_SECRET=at-least-16-random-characters
# Additive ordered-content envelope and deterministic document profiling.
# Keep false until migration 31 is applied and the golden corpus passes.

# 6. Email (Resend)
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=noreply@yourdomain.com

# 7. Cloudflare R2 (required for uploads + cross-phase PDF bundles)
CLOUDFLARE_R2_ACCESS_KEY_ID=your_cloudflare_r2_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_cloudflare_r2_secret_access_key
CLOUDFLARE_R2_ENDPOINT=https://your_cloudflare_account_id.r2.cloudflarestorage.com
CLOUDFLARE_R2_BUCKET_NAME=your_bucket_name
CLOUDFLARE_R2_PUBLIC_URL=https://your_public_r2_subdomain_or_custom_domain.com

# 8. Observability
SENTRY_DSN=

# 10. OpenRouter (PDF extraction's OCR model, and the text-only model used to
# auto-fix a question that fails validation on JSON bank upload). Optional —
# PDF extraction fails without it; the JSON-upload AI-fix pass just falls
# back to leaving unfixable questions as review-screen gaps.
OPENROUTER_API_KEY=your-openrouter-api-key
LLM_MODEL=deepseek/deepseek-v4-flash-0731

# 9. Firebase Admin
FIREBASE_SERVICE_ACCOUNT_JSON=
