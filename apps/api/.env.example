# ==========================================
# BACKEND API ENVIRONMENT VARIABLES EXAMPLE
# ==========================================

# 1. Server Config
NODE_ENV=production
PORT=3001
APP_URL=http://localhost:3000
# Apex domain only. The API will allow HTTPS requests from its direct subdomains.
APP_BASE_DOMAIN=classphere.com
# Optional comma-separated custom institute web origins, for example:
# https://learn.example.edu,https://app.other-institute.in
ALLOWED_WEB_ORIGINS=
START_WORKERS=false # Set to true on your standalone worker dyno/container

# 2. Supabase Keys (From Supabase Dashboard -> Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-never-expose-to-frontend
SUPABASE_JWT_SECRET=your-jwt-secret-from-supabase

# 3. Redis (Required for BullMQ async processing)
REDIS_URL=rediss://default:YOUR_PASSWORD@your-endpoint.upstash.io:6379

# 4. Security
# Random secure string for internal cron jobs/webhooks/superadmin to authenticate
INTERNAL_API_KEY=your-random-secure-string

# 5. Email (Resend)
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=noreply@yourdomain.com

# 6. Cloudflare R2 (Required for whitelabel asset uploads)
CLOUDFLARE_R2_ACCESS_KEY_ID=your_cloudflare_r2_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_cloudflare_r2_secret_access_key
CLOUDFLARE_R2_ENDPOINT=https://your_cloudflare_account_id.r2.cloudflarestorage.com
CLOUDFLARE_R2_BUCKET_NAME=your_bucket_name
CLOUDFLARE_R2_PUBLIC_URL=https://your_public_r2_subdomain_or_custom_domain.com

# 7. Observability
# Sentry DSN for backend error tracking
SENTRY_DSN=

# 8. Firebase Admin (required for Capacitor native push delivery)
# Paste the complete service-account JSON as a single line. Never expose it to the web app.
FIREBASE_SERVICE_ACCOUNT_JSON=
