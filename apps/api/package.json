{
  "name": "api",
  "version": "1.0.0",
  "description": "Express Backend",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "worker:dev": "ts-node-dev --respawn --transpile-only src/worker.ts",
    "build": "tsup src/index.ts src/worker.ts --format cjs --dts",
    "start": "node dist/index.js",
    "worker:start": "node dist/worker.js",
    "lint": "eslint \"src/**/*.ts*\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1087.0",
    "@sentry/node": "^10.65.0",
    "@sentry/profiling-node": "^10.65.0",
    "@supabase/supabase-js": "^2.110.0",
    "@types/multer": "^2.2.0",
    "bullmq": "^5.80.2",
    "cors": "^2.8.5",
    "csv-parse": "^7.0.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.5.2",
    "firebase-admin": "^14.2.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "resend": "^6.17.2",
    "undici": "^8.7.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "eslint-config": "*",
    "ts-node-dev": "^2.0.0",
    "tsconfig": "*",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5"
  }
}
