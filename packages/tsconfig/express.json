{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Express",
  "extends": "./base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "outDir": "dist",
    "target": "es2017",
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
